# FinAlly environment — copy to `.env` and fill in.
#
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is gitignored. In Docker these values arrive through `--env-file .env`
# (or compose's `env_file:`) — there is no `.env` inside the image. When the
# backend runs directly on the host it also loads this file from the project
# root if present; a missing `.env` is never an error. (PLAN.md §5)

# ── Required for chat ────────────────────────────────────────────────────────
# OpenRouter API key, used for the LLM assistant. If it is missing or empty,
# /api/chat returns a clear error and everything else works normally — it never
# prevents startup. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Massive (Polygon.io) API key for real market data. Leave empty to use the
# built-in GBM market simulator, which is the recommended default and needs no
# account. Set it and the backend polls Massive instead.
MASSIVE_API_KEY=

# Deterministic mock LLM responses — no OpenRouter call, no key needed.
# Used by the E2E suite. Accepts "true"/"1" (case-insensitive) to enable.
LLM_MOCK=false

# ── Advanced (defaults are fine; uncomment to override) ──────────────────────
# Seconds between Massive polls. Free tier is 5 calls/min, so 15s is the floor;
# paid tiers can go to 2-15s. Ignored when the simulator is in use.
# MASSIVE_POLL_INTERVAL_SECONDS=15

# Model used for the chat assistant, routed through OpenRouter to Cerebras.
# LLM_MODEL=openrouter/openai/gpt-oss-120b

# SQLite file location. The image sets /app/db/finally.db, which is where the
# named volume `finally-data` is mounted; on the host the default is
# db/finally.db relative to the project root. Only override if you know why.
# DB_PATH=db/finally.db

# Directory holding the built frontend. The image sets /app/static; on the host
# the default is `static`, and a missing directory just disables static serving.
# STATIC_DIR=static
